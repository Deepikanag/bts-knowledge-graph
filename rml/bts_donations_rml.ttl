@prefix bts:   <http://example.org/bts#> .
@prefix rr:    <http://www.w3.org/ns/r2rml#> .
@prefix rml:   <http://semweb.mmlab.be/ns/rml#> .
@prefix ql:    <http://semweb.mmlab.be/ns/ql#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix map:   <http://example.org/bts/mappings#> .

#################################################################
# Logical source: the CSV file with BTS donations
#################################################################

map:DonationSource a rml:LogicalSource ;
    rml:source "data/csv/bts_donations.csv" ;
    rml:referenceFormulation ql:CSV .

#################################################################
# Triples Map: Donations
#################################################################

map:DonationTriplesMap a rr:TriplesMap ;
    rml:logicalSource map:DonationSource ;

    # Each row becomes a bts:Donation individual
    rr:subjectMap [
        rr:template "http://example.org/bts/donation/{donation_id}" ;
        rr:class bts:Donation
    ] ;

    # Donation label as bts:name
    rr:predicateObjectMap [
        rr:predicate bts:name ;
        rr:objectMap [ rml:reference "donation_label" ]
    ] ;

    # Donation amount (using the USD column, cast to decimal)
    rr:predicateObjectMap [
        rr:predicate bts:donationAmount ;
        rr:objectMap [
            rml:reference "amount_usd" ;
            rr:datatype xsd:decimal
        ]
    ] ;

    # Link to donor (member or group) via IRI based on donor_label.
    # Assumes individuals such as bts:RM, bts:Suga, bts:BTS exist in ontology.
    rr:predicateObjectMap [
        rr:predicate bts:madeBy ;
        rr:objectMap [
            rr:template "http://example.org/bts#{donor_label}"
        ]
    ] ;

    # Link to recipient organization (uses OrganizationTriplesMap)
    rr:predicateObjectMap [
        rr:predicate bts:donatedTo ;
        rr:objectMap [
            rr:parentTriplesMap map:OrganizationTriplesMap ;
            rr:joinCondition [
                rr:child  "org_name" ;
                rr:parent "org_name"
            ]
        ]
    ] ;

    # Link to social issue (uses SocialIssueTriplesMap)
    rr:predicateObjectMap [
        rr:predicate bts:addressesIssue ;
        rr:objectMap [
            rr:parentTriplesMap map:SocialIssueTriplesMap ;
            rr:joinCondition [
                rr:child  "issue_key" ;
                rr:parent "issue_key"
            ]
        ]
    ] ;

    # Optional link to campaign, if campaign_label is present
    rr:predicateObjectMap [
        rr:predicate bts:partOfCampaign ;
        rr:objectMap [
            rr:parentTriplesMap map:CampaignTriplesMap ;
            rr:joinCondition [
                rr:child  "campaign_label" ;
                rr:parent "campaign_label"
            ]
        ]
    ] .

#################################################################
# Triples Map: Organizations
#################################################################

map:OrganizationTriplesMap a rr:TriplesMap ;
    rml:logicalSource map:DonationSource ;

    rr:subjectMap [
        rr:template "http://example.org/bts/org/{org_name}" ;
        rr:class bts:Organization
    ] ;

    # Organization name as bts:name
    rr:predicateObjectMap [
        rr:predicate bts:name ;
        rr:objectMap [ rml:reference "org_name" ]
    ] .

#################################################################
# Triples Map: Social Issues
#################################################################

map:SocialIssueTriplesMap a rr:TriplesMap ;
    rml:logicalSource map:DonationSource ;

    rr:subjectMap [
        rr:template "http://example.org/bts/issue/{issue_key}" ;
        rr:class bts:SocialIssue
    ] ;

    # Use issue_key as a simple label
    rr:predicateObjectMap [
        rr:predicate bts:name ;
        rr:objectMap [ rml:reference "issue_key" ]
    ] .

#################################################################
# Triples Map: Campaigns
#################################################################

map:CampaignTriplesMap a rr:TriplesMap ;
    rml:logicalSource map:DonationSource ;

    rr:subjectMap [
        rr:template "http://example.org/bts/campaign/{campaign_label}" ;
        rr:class bts:Campaign
    ] ;

    # Campaign label as name
    rr:predicateObjectMap [
        rr:predicate bts:name ;
        rr:objectMap [ rml:reference "campaign_label" ]
    ] .
