@prefix bts:  <http://example.org/bts#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix rr:  <http://www.w3.org/ns/r2rml#> .
@prefix ql:  <http://semweb.mmlab.be/ns/ql#> .

#################################################################
# Logical Source
#################################################################

# All Triples Maps below read from the same CSV file:
# data/csv/bts_donations.csv

<#DonationsSource> a rml:LogicalSource ;
    rml:source "data/csv/bts_donations.csv" ;
    rml:referenceFormulation ql:CSV .

#################################################################
# Triples Map: Donation
#################################################################

<#DonationTriplesMap> a rr:TriplesMap ;
    rml:logicalSource <#DonationsSource> ;

    # Each row becomes a unique Donation instance
    rr:subjectMap [
        rr:template "http://example.org/bts/donation/{donation_id}" ;
        rr:class bts:Donation
    ] ;

    # Donation label → bts:name
    rr:predicateObjectMap [
        rr:predicate bts:name ;
        rr:objectMap [ rml:reference "donation_label" ]
    ] ;

    # Amount in USD → bts:donationAmount
    rr:predicateObjectMap [
        rr:predicate bts:donationAmount ;
        rr:objectMap [
            rml:reference "amount_usd" ;
            rr:datatype xsd:decimal
        ]
    ] ;

    # Donation date → bts:eventDate
    rr:predicateObjectMap [
        rr:predicate bts:eventDate ;
        rr:objectMap [
            rml:reference "donation_date" ;
            rr:datatype xsd:date
        ]
    ] ;

    # Link to Organization instance
    rr:predicateObjectMap [
        rr:predicate bts:donatedTo ;
        rr:objectMap [
            rr:template "http://example.org/bts/org/{org_name}"
        ]
    ] ;

    # Link to SocialIssue instance
    rr:predicateObjectMap [
        rr:predicate bts:addressesIssue ;
        rr:objectMap [
            rr:template "http://example.org/bts/issue/{issue_key}"
        ]
    ] ;

    # Link to Campaign instance (if campaign_label non-empty, it becomes a real campaign;
    # otherwise it will still generate an IRI but can be ignored in queries if desired)
    rr:predicateObjectMap [
        rr:predicate bts:partOfCampaign ;
        rr:objectMap [
            rr:template "http://example.org/bts/campaign/{campaign_label}"
        ]
    ] ;

    # Link to Donor (Member or Group). We assume individuals with IRIs
    # like bts:RM, bts:Suga, bts:BTS etc. will be defined separately in the instances file.
    rr:predicateObjectMap [
        rr:predicate bts:madeBy ;
        rr:objectMap [
            rr:template "http://example.org/bts/{donor_label}"
        ]
    ] .

#################################################################
# Triples Map: Organization
#################################################################

<#OrganizationTriplesMap> a rr:TriplesMap ;
    rml:logicalSource <#DonationsSource> ;

    # One Organization per org_name (same template as in Donation map)
    rr:subjectMap [
        rr:template "http://example.org/bts/org/{org_name}" ;
        rr:class bts:Organization
    ] ;

    # Organization name → bts:name
    rr:predicateObjectMap [
        rr:predicate bts:name ;
        rr:objectMap [ rml:reference "org_name" ]
    ] .

#################################################################
# Triples Map: Social Issue
#################################################################

<#IssueTriplesMap> a rr:TriplesMap ;
    rml:logicalSource <#DonationsSource> ;

    rr:subjectMap [
        rr:template "http://example.org/bts/issue/{issue_key}" ;
        rr:class bts:SocialIssue
    ] ;

    # Use issue_key as a simple label (e.g. "health", "education")
    rr:predicateObjectMap [
        rr:predicate bts:name ;
        rr:objectMap [ rml:reference "issue_key" ]
    ] .

#################################################################
# Triples Map: Campaign
#################################################################

<#CampaignTriplesMap> a rr:TriplesMap ;
    rml:logicalSource <#DonationsSource> ;

    rr:subjectMap [
        rr:template "http://example.org/bts/campaign/{campaign_label}" ;
        rr:class bts:Campaign
    ] ;

    # Campaign label (e.g., "Love Myself") → bts:name
    rr:predicateObjectMap [
        rr:predicate bts:name ;
        rr:objectMap [ rml:reference "campaign_label" ]
    ] .
