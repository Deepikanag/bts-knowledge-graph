@prefix bts: <http://example.org/bts#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/bts/tour/TOUR_REDBULLET>
    a bts:Tour ;
    bts:tourName "The Red Bullet Tour" ;
    bts:tourType "Concert Tour" ;
    bts:startDate "2014-10-17"^^xsd:date ;
    bts:endDate "2015-08-29"^^xsd:date ;
    bts:regions "Asia;Australia;North America;South America" ;
    bts:memberLabel "BTS" ;
    bts:notes "First international tour" .

