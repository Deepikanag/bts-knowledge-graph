@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix bts: <http://example.org/bts#> .

# === Classes ===
bts:Group a rdfs:Class .
bts:Member a rdfs:Class .
bts:Organization a rdfs:Class .
bts:Campaign a rdfs:Class .
bts:SocialIssue a rdfs:Class .
bts:Donation a rdfs:Class .
bts:FanProject a rdfs:Class .
bts:Award a rdfs:Class .
bts:RecordAchievement a rdfs:Class .
bts:Event a rdfs:Class .
bts:SpeechEvent a rdfs:Class ; rdfs:subClassOf bts:Event .
bts:MusicRelease a rdfs:Class .
bts:Album a rdfs:Class ; rdfs:subClassOf bts:MusicRelease .
bts:Song a rdfs:Class ; rdfs:subClassOf bts:MusicRelease .
bts:SoloWork a rdfs:Class ; rdfs:subClassOf bts:MusicRelease .
bts:Tour a rdfs:Class .
bts:MusicVideo a rdfs:Class .
bts:BrandEndorsement a rdfs:Class .
bts:ManagementRelationship a rdfs:Class .

# === Generic Descriptive Properties ===
bts:name a rdf:Property ;
    rdfs:domain rdfs:Resource ;
    rdfs:range xsd:string .

bts:title a rdf:Property ;
    rdfs:domain bts:Album , bts:Song , bts:SoloWork ;
    rdfs:range xsd:string .

bts:releaseDate a rdf:Property ;
    rdfs:domain bts:Album , bts:Song , bts:SoloWork ;
    rdfs:range xsd:date .

bts:albumCategory a rdf:Property ;
    rdfs:domain bts:Album ;
    rdfs:range xsd:string .

bts:language a rdf:Property ;
    rdfs:domain bts:Album , bts:Song ;
    rdfs:range xsd:string .

bts:label a rdf:Property ;
    rdfs:domain bts:Album ;
    rdfs:range xsd:string .

bts:duration a rdf:Property ;
    rdfs:domain bts:Song ;
    rdfs:range xsd:string .

# === Membership & Music Creation ===
bts:hasMember a rdf:Property ;
    rdfs:domain bts:Group ;
    rdfs:range bts:Member .

bts:memberOf a rdf:Property ;
    rdfs:domain bts:Member ;
    rdfs:range bts:Group .

bts:createdBy a rdf:Property ;
    rdfs:domain bts:Album ;
    rdfs:range rdfs:Resource .

bts:featuresMember a rdf:Property ;
    rdfs:domain bts:Album , bts:Song ;
    rdfs:range bts:Member .

bts:hasPart a rdf:Property ;
    rdfs:domain bts:Album ;
    rdfs:range bts:Song .

bts:album a rdf:Property ;
    rdfs:domain bts:Song ;
    rdfs:range bts:Album .

bts:fromAlbum a rdf:Property ;
    rdfs:domain bts:Song ;
    rdfs:range bts:Album .

bts:primaryArtist a rdf:Property ;
    rdfs:domain bts:Song ;
    rdfs:range xsd:string .

bts:featuringArtist a rdf:Property ;
    rdfs:domain bts:Song ;
    rdfs:range xsd:string .

bts:isTitleTrack a rdf:Property ;
    rdfs:domain bts:Song ;
    rdfs:range xsd:string .

# === Performances, Events, and Awards ===
bts:performedBy a rdf:Property ;
    rdfs:domain bts:SoloWork , bts:Tour ;
    rdfs:range rdfs:Resource .

bts:performedAt a rdf:Property ;
    rdfs:domain rdfs:Resource ;
    rdfs:range bts:Event .

bts:eventDate a rdf:Property ;
    rdfs:domain bts:Event , bts:Donation ;
    rdfs:range xsd:date .

bts:tourName a rdf:Property ;
    rdfs:domain bts:Tour ;
    rdfs:range xsd:string .

bts:tourType a rdf:Property ;
    rdfs:domain bts:Tour ;
    rdfs:range xsd:string .

bts:regions a rdf:Property ;
    rdfs:domain bts:Tour ;
    rdfs:range xsd:string .

bts:hasAward a rdf:Property ;
    rdfs:domain bts:Group , bts:Member ;
    rdfs:range bts:Award .

bts:awardYear a rdf:Property ;
    rdfs:domain bts:Award ;
    rdfs:range xsd:gYear .

# === Record Achievements ===
bts:hasRecord a rdf:Property ;
    rdfs:domain bts:Song , bts:MusicVideo ;
    rdfs:range bts:RecordAchievement .

bts:recordValue a rdf:Property ;
    rdfs:domain bts:RecordAchievement ;
    rdfs:range xsd:string .

# === Donations, Campaigns, Social Impact ===
bts:donationAmount a rdf:Property ;
    rdfs:domain bts:Donation , bts:FanProject ;
    rdfs:range xsd:decimal .

bts:madeBy a rdf:Property ;
    rdfs:domain bts:Donation ;
    rdfs:range rdfs:Resource .

bts:donatedTo a rdf:Property ;
    rdfs:domain bts:Donation ;
    rdfs:range bts:Organization .

bts:addressesIssue a rdf:Property ;
    rdfs:domain bts:Donation , bts:FanProject ;
    rdfs:range bts:SocialIssue .

bts:partOfCampaign a rdf:Property ;
    rdfs:domain bts:Donation ;
    rdfs:range bts:Campaign .

bts:donorLabel a rdf:Property ;
    rdfs:domain bts:Donation ;
    rdfs:range xsd:string .

bts:donorType a rdf:Property ;
    rdfs:domain bts:Donation ;
    rdfs:range xsd:string .

bts:donationLabel a rdf:Property ;
    rdfs:domain bts:Donation ;
    rdfs:range xsd:string .

bts:amountKRW a rdf:Property ;
    rdfs:domain bts:Donation ;
    rdfs:range xsd:decimal .

bts:amountUSD a rdf:Property ;
    rdfs:domain bts:Donation ;
    rdfs:range xsd:decimal .

bts:donationDate a rdf:Property ;
    rdfs:domain bts:Donation ;
    rdfs:range xsd:date .

bts:country a rdf:Property ;
    rdfs:domain bts:Donation ;
    rdfs:range xsd:string .

bts:orgName a rdf:Property ;
    rdfs:domain bts:Donation ;
    rdfs:range xsd:string .

bts:orgType a rdf:Property ;
    rdfs:domain bts:Donation ;
    rdfs:range xsd:string .

bts:issueKey a rdf:Property ;
    rdfs:domain bts:Donation ;
    rdfs:range xsd:string .

bts:campaignLabel a rdf:Property ;
    rdfs:domain bts:Donation ;
    rdfs:range xsd:string .

# === Organizations, Campaigns, Fan Projects ===
bts:projectName a rdf:Property ;
    rdfs:domain bts:FanProject ;
    rdfs:range xsd:string .

bts:organizedBy a rdf:Property ;
    rdfs:domain bts:FanProject ;
    rdfs:range xsd:string .

bts:description a rdf:Property ;
    rdfs:domain bts:FanProject ;
    rdfs:range xsd:string .

# === Media & Management Structures ===
bts:linkedToSong a rdf:Property ;
    rdfs:domain bts:MusicVideo ;
    rdfs:range bts:Song .

bts:director a rdf:Property ;
    rdfs:domain bts:MusicVideo ;
    rdfs:range xsd:string .

bts:views24h a rdf:Property ;
    rdfs:domain bts:MusicVideo ;
    rdfs:range xsd:decimal .

bts:platformRecord a rdf:Property ;
    rdfs:domain bts:MusicVideo ;
    rdfs:range xsd:string .

bts:endorsedBy a rdf:Property ;
    rdfs:domain bts:BrandEndorsement ;
    rdfs:range rdfs:Resource .

bts:brandName a rdf:Property ;
    rdfs:domain bts:BrandEndorsement ;
    rdfs:range xsd:string .

bts:industry a rdf:Property ;
    rdfs:domain bts:BrandEndorsement ;
    rdfs:range xsd:string .

bts:role a rdf:Property ;
    rdfs:domain bts:BrandEndorsement ;
    rdfs:range xsd:string .

bts:region a rdf:Property ;
    rdfs:domain bts:BrandEndorsement , bts:Tour ;
    rdfs:range xsd:string .

bts:entityType a rdf:Property ;
    rdfs:domain bts:BrandEndorsement ;
    rdfs:range xsd:string .

bts:entityLabel a rdf:Property ;
    rdfs:domain bts:BrandEndorsement ;
    rdfs:range xsd:string .

bts:contractStart a rdf:Property ;
    rdfs:domain bts:BrandEndorsement ;
    rdfs:range xsd:date .

bts:contractEnd a rdf:Property ;
    rdfs:domain bts:BrandEndorsement ;
    rdfs:range xsd:date .

bts:notes a rdf:Property ;
    rdfs:domain bts:BrandEndorsement ;
    rdfs:range xsd:string .

bts:startDate a rdf:Property ;
    rdfs:domain bts:Tour , bts:BrandEndorsement , bts:ManagementRelationship ;
    rdfs:range xsd:date .

bts:endDate a rdf:Property ;
    rdfs:domain bts:Tour , bts:BrandEndorsement , bts:ManagementRelationship ;
    rdfs:range xsd:date .

bts:managedEntity a rdf:Property ;
    rdfs:domain bts:ManagementRelationship ;
    rdfs:range rdfs:Resource .

bts:companyName a rdf:Property ;
    rdfs:domain bts:ManagementRelationship ;
    rdfs:range xsd:string .

bts:companyRole a rdf:Property ;
    rdfs:domain bts:ManagementRelationship ;
    rdfs:range xsd:string .

bts:ownershipType a rdf:Property ;
    rdfs:domain bts:ManagementRelationship ;
    rdfs:range xsd:string .

bts:ownershipDetail a rdf:Property ;
    rdfs:domain bts:ManagementRelationship ;
    rdfs:range xsd:string .
