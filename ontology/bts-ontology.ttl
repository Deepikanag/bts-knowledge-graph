@prefix bts: <http://example.org/bts#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

bts:Album rdf:type owl:Class ;
	rdfs:subClassOf bts:MusicRelease .

bts:Award rdf:type owl:Class .

bts:Campaign rdf:type owl:Class .

bts:Donation rdf:type owl:Class .

bts:Event rdf:type owl:Class .

bts:FanProject rdf:type owl:Class .

bts:Group rdf:type owl:Class .

bts:Member rdf:type owl:Class .

bts:MusicRelease rdf:type owl:Class .

bts:Organization rdf:type owl:Class .

bts:RecordAchievement rdf:type owl:Class .

bts:SocialIssue rdf:type owl:Class .

bts:Song rdf:type owl:Class ;
	rdfs:subClassOf bts:MusicRelease .

bts:SpeechEvent rdf:type owl:Class ;
	rdfs:subClassOf bts:Event .

