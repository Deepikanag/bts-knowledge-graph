@prefix bts:  <http://example.org/bts#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

#################################################################
# Core Individuals: Group and Members
#################################################################

bts:BTS a bts:Group ;
    bts:name "BTS" ;
    bts:hasMember bts:RM ,
                  bts:Jin ,
                  bts:Suga ,
                  bts:JHope ,
                  bts:Jimin ,
                  bts:V ,
                  bts:Jungkook .

bts:RM a bts:Member ;
    bts:name "RM" ;
    bts:memberOf bts:BTS .

bts:Jin a bts:Member ;
    bts:name "Jin" ;
    bts:memberOf bts:BTS .

bts:Suga a bts:Member ;
    bts:name "SUGA" ;
    bts:memberOf bts:BTS .

bts:JHope a bts:Member ;
    bts:name "j-hope" ;
    bts:memberOf bts:BTS .

bts:Jimin a bts:Member ;
    bts:name "Jimin" ;
    bts:memberOf bts:BTS .

bts:V a bts:Member ;
    bts:name "V" ;
    bts:memberOf bts:BTS .

bts:Jungkook a bts:Member ;
    bts:name "Jungkook" ;
    bts:memberOf bts:BTS .

bts:BigHitMusic a bts:Organization ;
    bts:name "Big Hit Music" .

