    bts:name "Billboard Music Awards - Top Social Artist 2017" ;
    bts:awardYear "2017"^^xsd:gYear .

bts:BBMAsTopSocialArtist2018 a bts:Award ;
    bts:name "Billboard Music Awards - Top Social Artist 2018" ;
    bts:awardYear "2018"^^xsd:gYear .

bts:BBMAsTopSocialArtist2019 a bts:Award ;
    bts:name "Billboard Music Awards - Top Social Artist 2019" ;
    bts:awardYear "2019"^^xsd:gYear .

bts:BTS
