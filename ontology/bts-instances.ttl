#################################################################
# Record Achievements
#################################################################

bts:DNA_YouTube24hRecord a bts:RecordAchievement ;
    bts:name "YouTube 24-hour view record for 'DNA'" ;
    bts:recordValue "Most-viewed K-pop group MV in first 24 hours on YouTube (2017)" .

bts:Butter_YouTube24hRecord a bts:RecordAchievement ;
    bts:name "YouTube 24-hour view record for 'Butter'" ;
    bts:recordValue "One of the most-viewed music videos in first 24 hours on YouTube (2021)" .

bts:DNA bts:hasRecord bts:DNA_YouTube24hRecord .
bts:Butter bts:hasRecord bts:Butter_YouTube24hRecord .

