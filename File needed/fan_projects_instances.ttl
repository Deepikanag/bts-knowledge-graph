@prefix bts: <http://example.org/bts#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/bts/fanProject/FP_PURPLERIBBON>
    a bts:FanProject ;
    bts:projectName "Purple Ribbon Project" ;
    bts:fanCommunity "Global ARMY" ;
    bts:country "Global" ;
    bts:startDate "2017-11-01"^^xsd:date ;
    bts:issueKey "respect-campaign" ;
    bts:donationAmountUSD "0.0"^^xsd:decimal ;
    bts:description "Encouraging safe fan behavior" .

