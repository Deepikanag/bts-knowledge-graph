@prefix bts: <http://example.org/bts#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/bts/endorsement/BE_BTS_SAMSUNG>
    a bts:BrandEndorsement ;
    bts:entityType "Group" ;
    bts:entityLabel "BTS" ;
    bts:brandName "Samsung" ;
    bts:industry "Electronics" ;
    bts:role "Global Ambassador" ;
    bts:contractStart "2020-02-01"^^xsd:date ;
    bts:contractEnd "2021-12-31"^^xsd:date ;
    bts:region "Global" ;
    bts:notes "Galaxy S20, BTS Edition" .

