@prefix bts: <http://example.org/bts#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/bts/mv/MV_DNA>
    a bts:MusicVideo ;
    bts:title "DNA" ;
    bts:forSong <http://example.org/bts/song/SONG_DNA> ;
    bts:releaseDate "2017-09-18"^^xsd:date ;
    bts:director "Choi Yong Seok" ;
    bts:views24hMillions "22.0"^^xsd:decimal ;
    bts:platformRecord "Most viewed K-pop group MV in 24h (2017)" ;
    bts:notes "DNA held 24h record" .

