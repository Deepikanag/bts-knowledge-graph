@prefix bts: <http://example.org/bts#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/bts/managementRelation/MGMT_BTS_BIGHIT>
    a bts:ManagementRelation ;
    bts:entityType "Group" ;
    bts:entityLabel "BTS" ;
    bts:companyName "BIGHIT MUSIC" ;
    bts:companyRole "Managed By" ;
    bts:startDate "2013-06-13"^^xsd:date ;
    bts:endDate "Present"^^xsd:date ;
    bts:ownershipType "management" ;
    bts:ownershipDetail "" ;
    bts:notes "Original contract under BigHit Entertainment" .

<http://example.org/bts/managementRelation/MGMT_BIGHIT_HYBE>
