PREFIX bts:  <http://example.org/bts#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

SELECT ?song ?songLabel ?record ?recordName ?recordValue
WHERE {
  ?song rdf:type bts:Song .
  OPTIONAL { ?song bts:title ?title . }
  OPTIONAL { ?song bts:name ?legacyName . }
  BIND (COALESCE(?title, ?legacyName) AS ?songLabel)

  OPTIONAL {
    ?song bts:hasRecord ?record .
    ?record bts:name ?recordName ;
            bts:recordValue ?recordValue .
  }
}
ORDER BY ?songLabel
