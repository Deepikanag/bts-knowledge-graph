PREFIX bts:  <http://example.org/bts#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

SELECT ?release ?label ?type ?date
WHERE {
  VALUES ?type { bts:Album bts:Song }

  ?release rdf:type ?type ;
           bts:releaseDate ?date .

  OPTIONAL { ?release bts:title ?title . }
  OPTIONAL { ?release bts:name ?name . }

  BIND (COALESCE(?title, ?name, "") AS ?label)
}
ORDER BY ?date ?label
