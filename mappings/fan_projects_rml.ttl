@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix ql: <http://semweb.mmlab.be/ns/ql#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix bts: <http://example.org/bts#> .
@prefix map: <http://example.org/mapping/> .

<#FanProjectSource>
    rml:source "data/csv/fan_projects.csv" ;
    rml:referenceFormulation ql:CSV .

<#FanProjectTriplesMap>
    rml:logicalSource <#FanProjectSource> ;
    rr:subjectMap [
        rr:template "http://example.org/bts/fanproject/{project_id}" ;
        rr:class bts:FanProject ;
    ] ;
    rr:predicateObjectMap [
        rr:predicate bts:projectName ;
        rr:objectMap [ rml:reference "project_name" ] ;
    ] ;
    rr:predicateObjectMap [
        rr:predicate bts:organizedBy ;
        rr:objectMap [ rml:reference "fan_community" ] ;
    ] ;
    rr:predicateObjectMap [
        rr:predicate bts:region ;
        rr:objectMap [ rml:reference "country" ] ;
    ] ;
    rr:predicateObjectMap [
        rr:predicate bts:startDate ;
        rr:objectMap [ rml:reference "start_date" ; rr:datatype xsd:date ] ;
    ] ;
    rr:predicateObjectMap [
        rr:predicate bts:addressesIssue ;
        rr:objectMap [
            rr:parentTriplesMap <#IssueTriplesMap> ;
            rr:joinCondition [
                rr:child "issue_key" ;
                rr:parent "issue_key" ;
            ]
        ] ;
    ] ;
    rr:predicateObjectMap [
        rr:predicate bts:donationAmount ;
        rr:objectMap [ rml:reference "donation_amount_usd" ; rr:datatype xsd:decimal ] ;
    ] ;
    rr:predicateObjectMap [
        rr:predicate bts:description ;
        rr:objectMap [ rml:reference "description" ] ;
    ] .

<#IssueTriplesMap>
    rml:logicalSource <#FanProjectSource> ;
    rr:subjectMap [
        rr:template "http://example.org/bts/issue/{issue_key}" ;
        rr:class bts:SocialIssue ;
    ] ;
    rr:predicateObjectMap [
        rr:predicate bts:name ;
        rr:objectMap [ rml:reference "issue_key" ] ;
    ] .