@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix ql: <http://semweb.mmlab.be/ns/ql#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix bts: <http://example.org/bts#> .
@prefix map: <http://example.org/mapping/> .

<#ManagementSource>
    rml:source "data/csv/management.csv" ;
    rml:referenceFormulation ql:CSV .

<#ManagementTriplesMap>
    rml:logicalSource <#ManagementSource> ;
    rr:subjectMap [
        rr:template "http://example.org/bts/management/{relation_id}" ;
        rr:class bts:ManagementRelationship ;
    ] ;
    rr:predicateObjectMap [
        rr:predicate bts:managedEntity ;
        rr:objectMap [ rr:template "http://example.org/bts/{entity_label}" ] ;
    ] ;
    rr:predicateObjectMap [
        rr:predicate bts:companyName ;
        rr:objectMap [ rml:reference "company_name" ] ;
    ] ;
    rr:predicateObjectMap [
        rr:predicate bts:companyRole ;
        rr:objectMap [ rml:reference "company_role" ] ;
    ] ;
    rr:predicateObjectMap [
        rr:predicate bts:startDate ;
        rr:objectMap [ rml:reference "start_date" ; rr:datatype xsd:date ] ;
    ] ;
    rr:predicateObjectMap [
        rr:predicate bts:endDate ;
        rr:objectMap [ rml:reference "end_date" ; rr:datatype xsd:date ] ;
    ] ;
    rr:predicateObjectMap [
        rr:predicate bts:ownershipType ;
        rr:objectMap [ rml:reference "ownership_type" ] ;
    ] ;
    rr:predicateObjectMap [
        rr:predicate bts:ownershipDetail ;
        rr:objectMap [ rml:reference "ownership_detail" ] ;
    ] ;
    rr:predicateObjectMap [
        rr:predicate bts:notes ;
        rr:objectMap [ rml:reference "notes" ] ;
    ] .
