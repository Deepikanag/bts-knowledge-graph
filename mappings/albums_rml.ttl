@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix ql: <http://semweb.mmlab.be/ns/ql#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix bts: <http://example.org/bts#> .
@prefix map: <http://example.org/mapping/> .

<#AlbumSource>
    rml:source "data/csv/albums.csv" ;
    rml:referenceFormulation ql:CSV .

<#AlbumTriplesMap>
    rml:logicalSource <#AlbumSource> ;
    rr:subjectMap [
        rr:template "http://example.org/bts/album/{album_id}" ;
        rr:class bts:Album ;
    ] ;
    rr:predicateObjectMap [
        rr:predicate bts:title ;
        rr:objectMap [ rml:reference "title" ] ;
    ] ;
    rr:predicateObjectMap [
        rr:predicate bts:releaseDate ;
        rr:objectMap [ rml:reference "release_date" ; rr:datatype xsd:date ] ;
    ] ;
    rr:predicateObjectMap [
        rr:predicate bts:albumCategory ;
        rr:objectMap [ rml:reference "category" ] ;
    ] ;
    rr:predicateObjectMap [
        rr:predicate bts:language ;
        rr:objectMap [ rml:reference "language" ] ;
    ] ;
    rr:predicateObjectMap [
        rr:predicate bts:label ;
        rr:objectMap [ rml:reference "label" ] ;
    ] ;
    rr:predicateObjectMap [
        rr:predicate bts:notes ;
        rr:objectMap [ rml:reference "notes" ] ;
    ] ;
    rr:predicateObjectMap [
        rr:predicate bts:createdBy ;
        rr:objectMap [
            rr:template "http://example.org/bts/{artist_label}" ;
        ]
    ] .
