@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix ql: <http://semweb.mmlab.be/ns/ql#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix bts: <http://example.org/bts#> .
@prefix map: <http://example.org/mapping/> .

<#EndorsementSource>
    rml:source "data/csv/brand_endorsements.csv" ;
    rml:referenceFormulation ql:CSV .

<#EndorsementTriplesMap>
    rml:logicalSource <#EndorsementSource> ;
    rr:subjectMap [
        rr:template "http://example.org/bts/endorsement/{endorsement_id}" ;
        rr:class bts:BrandEndorsement ;
    ] ;
    rr:predicateObjectMap [
        rr:predicate bts:endorsedBy ;
        rr:objectMap [
            rr:template "http://example.org/bts/{entity_label}" ;
        ]
    ] ;
    rr:predicateObjectMap [
        rr:predicate bts:brandName ;
        rr:objectMap [ rml:reference "brand_name" ] ;
    ] ;
    rr:predicateObjectMap [
        rr:predicate bts:industry ;
        rr:objectMap [ rml:reference "industry" ] ;
    ] ;
    rr:predicateObjectMap [
        rr:predicate bts:role ;
        rr:objectMap [ rml:reference "role" ] ;
    ] ;
    rr:predicateObjectMap [
        rr:predicate bts:startDate ;
        rr:objectMap [ rml:reference "contract_start" ; rr:datatype xsd:date ] ;
    ] ;
    rr:predicateObjectMap [
        rr:predicate bts:endDate ;
        rr:objectMap [ rml:reference "contract_end" ; rr:datatype xsd:date ] ;
    ] ;
    rr:predicateObjectMap [
        rr:predicate bts:region ;
        rr:objectMap [ rml:reference "region" ] ;
    ] ;
    rr:predicateObjectMap [
        rr:predicate bts:notes ;
        rr:objectMap [ rml:reference "notes" ] ;
    ] .
